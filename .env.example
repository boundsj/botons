# compose.yaml's own settings. Copy to .env and edit; .env is never committed. Only the values compose.yaml
# names reach a container. The server's settings go in botons.env (see botons.env.example).

# Who reaches the app's port: 127.0.0.1 is this machine only. Changing it exposes plain HTTP to that network.
BOTONS_BIND=127.0.0.1
BOTONS_PUBLISH_PORT=7777

# The address devices open (and links in pushes and webhooks use).
#   local only:         http://localhost:7777
#   Tailscale overlay:  https://botons.example-tailnet.ts.net   (the sidecar's MagicDNS name)
#   Caddy overlay:      https://botons.example.com             (set BOTONS_DOMAIN too)
BOTONS_PUBLIC_URL=http://localhost:7777

# Caddy overlay (docker/compose.caddy.yaml): the public domain, its DNS pointing at this machine.
# BOTONS_DOMAIN=botons.example.com

# Tailscale overlay (docker/compose.tailscale.yaml): the owner creates an auth key in the Tailscale admin console.
# TS_AUTHKEY=
# TS_HOSTNAME=botons

# Which agent CLIs the image installs (1 or 0), and their versions.
# BOTONS_INSTALL_CLAUDE=1
# BOTONS_INSTALL_CODEX=1
# BOTONS_CLAUDE_CODE_VERSION=latest
# BOTONS_CODEX_VERSION=latest
