{
  "name": "botons",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "npm run build && npm run serve",
    "serve": "node server/src/index.ts",
    "dev": "node scripts/dev.ts",
    "build": "npm run build -w web",
    "typecheck": "tsc -p server && tsc -p web",
    "check:public": "node scripts/check-public.ts",
    "perf:chat": "node scripts/perf-chat.ts",
    "check:preview": "node scripts/check-preview.ts",
    "check:avatars": "node scripts/check-avatars.ts",
    "check:sidebar": "node scripts/check-sidebar.ts",
    "check:reactions": "node scripts/check-reactions.ts",
    "check:timestamps": "node scripts/check-timestamps.ts",
    "check:operations": "node scripts/check-operations.ts",
    "check:recovery": "node scripts/check-recovery.ts",
    "check:connectors": "node scripts/check-connectors.ts",
    "check:api-keys": "node scripts/check-api-keys.ts",
    "check:starters": "node scripts/check-starters.ts",
    "check:config": "node scripts/check-config.ts",
    "check:api-brains": "node scripts/check-api-brains.ts",
    "check:skills": "node scripts/check-skills.ts",
    "check:browser": "node scripts/check-browser.ts",
    "check:firstrun": "node scripts/check-firstrun.ts",
    "doctor": "node scripts/doctor.ts",
    "restore": "node scripts/restore.ts",
    "test": "node scripts/test-tier.mjs unit",
    "test:full": "node scripts/test-tier.mjs all",
    "backup": "node scripts/backup.ts",
    "backup:install": "node scripts/install-backup-timer.ts",
    "service:install": "node scripts/install-service.ts",
    "deploy": "node scripts/deploy.ts",
    "pair": "node scripts/pair.ts",
    "migrate:names": "node scripts/migrate-names.ts",
    "check:viewport": "node scripts/check-viewport.ts",
    "release:package": "npm run build && node installer/package-release.mjs",
    "check:themes": "node scripts/check-themes.ts",
    "test:integration": "node scripts/test-tier.mjs integration",
    "check:brain-update": "node scripts/check-brain-update.ts",
    "check:workspace": "node scripts/check-workspace-access.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "bin": {
    "botons": "installer/botons.mjs",
    "getbotons": "installer/botons.mjs"
  },
  "version": "0.1.1",
  "files": [
    "server/src/",
    "server/bin/",
    "server/package.json",
    "shared/",
    "web/dist/",
    "web/package.json",
    "scripts/login.ts",
    "scripts/doctor.ts",
    "scripts/pair.ts",
    "scripts/backup.ts",
    "scripts/restore.ts",
    "scripts/check-browser.ts",
    "scripts/install-service.ts",
    "scripts/install-backup-timer.ts",
    "scripts/migrate-names.ts",
    "LICENSE",
    "SECURITY.md",
    "installer/botons.mjs",
    "installer/admin.mjs",
    "installer/brain-clis.mjs",
    "installer/linger.mjs",
    "installer/output.mjs",
    "installer/revision.mjs",
    "installer/shell-path.mjs",
    "installer/source-lock.json",
    "scripts/botons.service",
    "scripts/botons-backup.service",
    "scripts/botons-backup.timer",
    "web/src/",
    "web/public/",
    "web/index.html",
    "web/vite.config.ts",
    "web/tsconfig.json",
    "scripts/dev-env.ts",
    "scripts/service-runner.ts"
  ]
}
