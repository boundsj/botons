FROM node:24-trixie AS artifact
WORKDIR /build
COPY . .
RUN npm ci && npm run release:package -- /tmp/botons-package && cd /tmp/botons-package && npm pack --pack-destination /tmp
FROM node:22.23.3-trixie
RUN apt-get update && apt-get install -y --no-install-recommends sudo systemd curl git xz-utils && rm -rf /var/lib/apt/lists/*
RUN echo 'node ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/botons-smoke
WORKDIR /work
COPY --chown=node:node . .
COPY --from=artifact --chown=node:node /tmp/getbotons-0.0.0.tgz /tmp/getbotons-0.0.0.tgz
USER node
CMD ["sh", "installer/smoke.sh"]
